generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  firstName           String
  lastName            String
  password            String?
  role                UserRole
  notes               String?
  workspaceId         String?
  clientStatus        ClientStatus          @default(LEAD)
  isBlacklisted       Boolean               @default(false)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  timeOffEntries      StaffTimeOff[]
  auditLogs           AuditLog[]
  messages            Message[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  clientProjects      Project[]             @relation("ClientProjects")
  ownedProjects       Project[]             @relation("OwnedProjects")
  workspace           Workspace?            @relation(fields: [workspaceId], references: [id])
  sentInvitations     WorkspaceInvitation[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String

  status      ProjectStatus

  ownerId     String
  clientId    String
  workspaceId String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  deposits    Deposit[]
  invoices    Invoice[]
  messages    Message[]
  milestones  Milestone[]
  files       ProjectFile[]
  proposals   Proposal[]

  client      User          @relation("ClientProjects", fields: [clientId], references: [id])
  owner       User          @relation("OwnedProjects", fields: [ownerId], references: [id])
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([ownerId])
  @@index([clientId])
  @@index([status])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  href      String?
  type      String?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  fileType  String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([createdAt])
}

model Milestone {
  id        String          @id @default(cuid())
  title     String
  status    MilestoneStatus
  projectId String
  dueDate   DateTime?
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([projectId])
  @@index([senderId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Proposal {
  id        String   @id @default(cuid())
  approved  Boolean  @default(false)
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([approved])
}

model Deposit {
  id             String         @id @default(cuid())

  amount         Decimal        @db.Decimal(10,2)

  status         DepositStatus  @default(REQUESTED)

  paymentMethod  PaymentMethod?

  dueDate        DateTime?

  requestedAt    DateTime       @default(now())

  paidAt         DateTime?

  notes          String?

  projectId      String

  createdAt      DateTime       @default(now())

  updatedAt      DateTime       @updatedAt

  project         Project          @relation(fields: [projectId], references: [id])

  payments        DepositPayment[]

  @@index([projectId])

  @@index([status])

  @@index([createdAt])
}

model DepositPayment {
  id             String         @id @default(cuid())

  depositId      String

  amount         Decimal        @db.Decimal(10,2)

  paymentMethod  PaymentMethod

  receivedAt     DateTime       @default(now())

  notes          String?

  createdAt      DateTime       @default(now())

  updatedAt      DateTime       @updatedAt

  deposit         Deposit @relation(fields: [depositId], references: [id])

  @@index([depositId])

  @@index([receivedAt])
}

model Invoice {
  id        String    @id @default(cuid())
  amount    Decimal   @db.Decimal(10,2)
  paid      Boolean   @default(false)
  
  projectId String
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([paid])
  @@index([createdAt])
}

model Workspace {
  id                  String                @id @default(cuid())
  name                String
  slug                String?               @unique
  companyName         String?
  logoImageUrl        String?
  accentColor         String?               @default("#8B5CF6")
  customDomain        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  apiKeys             ApiKey[]
  blackoutDates       BlackoutDate[]
  staffTimeOff        StaffTimeOff[]
  bookings            Booking[]
  bookingRules        BookingRule[]
  businessHours       BusinessHour[]
  executiveBriefCache ExecutiveBriefCache?
  projects            Project[]
  services            Service[]
  subscription        Subscription?
  users               User[]
  invitations         WorkspaceInvitation[]
}

model WorkspaceInvitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole
  token       String    @unique
  workspaceId String
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Subscription {
  id                   String           @id @default(cuid())
  workspaceId          String           @unique
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  plan                 SubscriptionPlan @default(STARTER)
  active               Boolean          @default(false)
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  workspace            Workspace        @relation(fields: [workspaceId], references: [id])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  status      String
  error       String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  duration     Int
  price        Int
  active       Boolean       @default(true)
  workspaceId  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     Booking[]
  bookingRules BookingRule[]
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Booking {
  id                    String        @id @default(cuid())
  
  customerName          String
  customerEmail         String
  customerPhone         String?
  notes                 String?

  date                  DateTime
  startTime             String
  endTime               String

  status                BookingStatus @default(CONFIRMED)

  serviceId             String
  workspaceId           String

  depositRequired       Boolean       @default(false)
  depositAmount         Decimal       @default(0) @db.Decimal(10, 2)
  depositPaid           Boolean       @default(false)
  depositPaidAt         DateTime?
  depositPaymentIntentId String?      @unique

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  googleCalendarEventId String?

  service               Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  workspace             Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([workspaceId, date])
  @@index([depositPaid])
}

model BusinessHour {
  id          String    @id @default(cuid())
  dayOfWeek   DayOfWeek
  openTime    String
  closeTime   String
  closed      Boolean   @default(false)
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dayOfWeek])
}

model BlackoutDate {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  startDate   DateTime
  endDate     DateTime
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, enabled])
  @@index([workspaceId, startDate])
  @@index([workspaceId, endDate])
  @@index([workspaceId, enabled, startDate, endDate])
}

model StaffTimeOff {
  id          String    @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  staffId     String
  staff       User      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  reason      String?

  startDate   DateTime
  endDate     DateTime

  enabled     Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([staffId])
  @@index([workspaceId, staffId])
  @@index([workspaceId, enabled])
  @@index([startDate])
  @@index([endDate])
}

model ExecutiveBriefCache {
  id          String              @id @default(cuid())
  workspaceId String              @unique
  narrative   String
  provider    String
  mode        ExecutiveBriefMode
  durationMs  Int
  generatedAt DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id])
}

model BookingRule {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String
  type String

  enabled Boolean @default(true)

  priority Int @default(100)

  value String?

  appliesToServiceId String?
  service            Service? @relation(fields: [appliesToServiceId], references: [id], onDelete: SetNull)

  appliesToStaffId String?

  dayOfWeek Int?

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, enabled])
  @@index([workspaceId, type])
  @@index([workspaceId, priority])
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  REVIEW
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ExecutiveBriefMode {
  mock
  production
}

enum ClientStatus {
  LEAD
  WAITLIST
  CONSULTATION
  DEPOSIT_PENDING
  ACTIVE
  COMPLETED
  ARCHIVED
  BANNED
}

enum DepositStatus {
  REQUESTED
  PARTIALLY_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHECK
  ACH
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}